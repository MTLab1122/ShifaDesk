  clinicId          String?   @map("clinic_id")
  recipientUserId   String    @map("recipient_user_id")
  title             String
  message           String
  category          String    @default("OPERATIONAL") // OPERATIONAL, APPOINTMENT, QUEUE, SECURITY, SYSTEM
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic        Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  recipientUser UserProfile  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([recipientUserId])
  @@index([readAt])
  @@index([createdAt])
  @@map("in_app_notifications")
}

/// Phone telephony integration credentials and assigned inbound numbers
model VoiceIntegration {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  clinicId              String   @map("clinic_id")
  provider              String   @default("TWILIO") // TWILIO, TELNYX, SIP
  providerAccountId     String   @map("provider_account_id") // Account SID / Account ID
  phoneNumber           String   @map("phone_number") // E.164 phone number
  providerConfiguration Json     @default("{}") @map("provider_configuration")
  enabled               Boolean  @default(true)
  verificationStatus    String   @default("CONNECTED") @map("verification_status") // CONNECTED, PENDING, DISCONNECTED
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  callSessions VoiceCallSession[]

  @@unique([clinicId, phoneNumber])
  @@index([organizationId])
  @@index([clinicId])
  @@index([phoneNumber])
  @@index([enabled])
  @@map("voice_integrations")
}

/// Telephony call session record tracking caller, state, audio duration, and language
model VoiceCallSession {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  clinicId             String    @map("clinic_id")
  voiceIntegrationId   String?   @map("voice_integration_id")
  providerCallId       String    @unique @map("provider_call_id") // e.g. Twilio CallSid
  callerPhone          String    @map("caller_phone")
  patientId            String?   @map("patient_id")
  callDirection        String    @default("INBOUND") @map("call_direction") // INBOUND, OUTBOUND
  callStatus           String    @default("INITIATED") @map("call_status") // INITIATED, RINGING, IN_PROGRESS, COMPLETED, BUSY, NO_ANSWER, FAILED, CANCELLED
  detectedLanguage     String    @default("en") @map("detected_language")
  selectedLanguage     String    @default("en") @map("selected_language")
  startedAt            DateTime  @default(now()) @map("started_at")
  answeredAt           DateTime? @map("answered_at")
  endedAt              DateTime? @map("ended_at")
  durationSeconds      Int       @default(0) @map("duration_seconds")
  handoverStatus       String    @default("NONE") @map("handover_status") // NONE, REQUESTED, TRANSFERRED, FAILED
  endReason            String?   @map("end_reason")
  recordingUrl         String?   @map("recording_url")
  recordingConsent     Boolean   @default(false) @map("recording_consent")
  verificationStatus   String    @default("UNVERIFIED") @map("verification_status") // UNVERIFIED, VERIFIED, EXEMPT
  verificationAttempts Int       @default(0) @map("verification_attempts")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic           Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  voiceIntegration VoiceIntegration?          @relation(fields: [voiceIntegrationId], references: [id], onDelete: SetNull)
  patient          Patient?                   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages         VoiceConversationMessage[]
  events           VoiceCallEvent[]
  handovers        VoiceHandoverRecord[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([providerCallId])
  @@index([callerPhone])
  @@index([patientId])
  @@index([callStatus])
  @@index([startedAt])
  @@map("voice_call_sessions")
}

/// Granular turns and transcribed messages within an active voice conversation
model VoiceConversationMessage {
  id              String   @id @default(uuid())
  callSessionId   String   @map("call_session_id")
  speaker         String   // CALLER, ASSISTANT, SYSTEM
  messageText     String   @map("message_text")
  language        String   @default("en")
  audioUrl        String?  @map("audio_url")
  confidenceScore Float?   @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at")

  callSession VoiceCallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([callSessionId])
  @@index([speaker])
  @@index([createdAt])
  @@map("voice_conversation_messages")
}

/// Telephony lifecycle event ledger (answering, speech gather, DTMF keypresses, transfers)
model VoiceCallEvent {
  id              String   @id @default(uuid())
  callSessionId   String   @map("call_session_id")
  providerEventId String?  @map("provider_event_id")
  eventType       String   @map("event_type")
  eventPayload    Json?    @default("{}") @map("event_payload")
  occurredAt      DateTime @default(now()) @map("occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")

  callSession VoiceCallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([callSessionId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("voice_call_events")
}

/// Clinic voice provider configuration, STT/TTS engine, and IVR greeting policies
model VoiceProviderSettings {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  clinicId                String?  @unique @map("clinic_id")
  sttProvider             String   @default("openai_whisper") @map("stt_provider")
  ttsProvider             String   @default("openai_tts") @map("tts_provider")
  llmProvider             String   @default("openai") @map("llm_provider")
  voiceModel              String   @default("alloy") @map("voice_model")
  voiceSpeed              Float    @default(1.0) @map("voice_speed")
  conversationTimeoutMs   Int      @default(15000) @map("conversation_timeout_ms")
  maxSilenceTimeoutMs     Int      @default(5000) @map("max_silence_timeout_ms")
  maxInteractionAttempts  Int      @default(3) @map("max_interaction_attempts")
  enableRecording         Boolean  @default(false) @map("enable_recording")
  recordingConsentMessage String   @default("This call may be recorded for quality and operations.") @map("recording_consent_message")
  transcriptRetentionDays Int      @default(30) @map("transcript_retention_days")
  humanTransferNumber     String?  @map("human_transfer_number")
  ivrGreetingMessage      String   @default("Welcome to the clinic AI Receptionist. For Urdu press 1, Da Pashto dapara 2, for English press 3.") @map("ivr_greeting_message")
  enabled                 Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@map("voice_provider_settings")
}

/// Human receptionist call transfer and handover records
model VoiceHandoverRecord {
  id             String    @id @default(uuid())
  callSessionId  String    @map("call_session_id")
  assignedUserId String?   @map("assigned_user_id")
  transferTarget String    @map("transfer_target")
  handoverReason String    @map("handover_reason")
  transferStatus String    @default("PENDING") @map("transfer_status") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  summary        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  callSession  VoiceCallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  assignedUser UserProfile?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([callSessionId])
  @@index([assignedUserId])
  @@index([transferStatus])
  @@index([createdAt])
  @@map("voice_handover_records")
}

// ==========================================
// Phase 10: Diagnostic Laboratory & Reports
// ==========================================

/// Diagnostic test categories (e.g. Hematology, Biochemistry, Microbiology)
model LaboratoryTestCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tests        LaboratoryTest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([clinicId])
  @@index([active])
  @@map("laboratory_test_categories")
}

/// Diagnostic test catalog definitions
model LaboratoryTest {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  clinicId                String?  @map("clinic_id")
  categoryId              String   @map("category_id")
  testCode                String   @map("test_code")
  testName                String   @map("test_name")
  description             String?
  sampleType              String   @default("Blood") @map("sample_type")
  collectionInstructions  String?  @map("collection_instructions")
  preparationInstructions String?  @map("preparation_instructions")
  processingNotes         String?  @map("processing_notes")
  turnaroundMinutes       Int      @default(240) @map("turnaround_minutes")
  price                   Float    @default(0)
  currency                String   @default("PKR")
  referenceRange          String?  @map("reference_range")
  unit                    String?
  resultType              String   @default("NUMERIC") @map("result_type") // NUMERIC, TEXT, QUALITATIVE, STRUCTURED
  active                  Boolean  @default(true)
  createdById             String?  @map("created_by_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category     LaboratoryTestCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  packageItems LaboratoryPackageItem[]
  orderItems   LaboratoryOrderItem[]

  @@unique([organizationId, testCode])
  @@index([organizationId])
  @@index([clinicId])
  @@index([categoryId])
  @@index([testCode])
  @@index([active])
  @@map("laboratory_tests")
}

/// Diagnostic test packages and panels (e.g. Lipid Profile, Complete Health Checkup)
model LaboratoryPackage {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  name           String
  code           String
  description    String?
  price          Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  items        LaboratoryPackageItem[]
  orderItems   LaboratoryOrderItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([clinicId])
  @@index([code])
  @@index([active])
  @@map("laboratory_packages")
}

/// Pivot linking packages to their member diagnostic tests
model LaboratoryPackageItem {
  id        String   @id @default(uuid())
  packageId String   @map("package_id")
  testId    String   @map("test_id")
  createdAt DateTime @default(now()) @map("created_at")

  package LaboratoryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test    LaboratoryTest    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])
  @@index([packageId])
  @@index([testId])
  @@map("laboratory_package_items")
}

/// Laboratory diagnostic order header
model LaboratoryOrder {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  clinicId               String    @map("clinic_id")
  patientId              String    @map("patient_id")
  orderingDoctorId       String?   @map("ordering_doctor_id")
  appointmentId          String?   @map("appointment_id")
  encounterId            String?   @map("encounter_id")
  orderReference         String    @unique @map("order_reference") // e.g. LAB-202611-0012
  orderStatus            String    @default("REGISTERED") @map("order_status") // DRAFT, REGISTERED, CONFIRMED, SAMPLE_PENDING, SAMPLE_COLLECTED, PROCESSING, RESULTS_PENDING, UNDER_REVIEW, APPROVED, REPORT_READY, DELIVERED, CANCELLED
  totalAmount            Float     @default(0) @map("total_amount")
  currency               String    @default("PKR")
  notes                  String?
  cancellationReason     String?   @map("cancellation_reason")
  createdById            String?   @map("created_by_id")
  expectedCompletionDate DateTime? @map("expected_completion_date")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic         Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderingDoctor Doctor?               @relation(fields: [orderingDoctorId], references: [id], onDelete: SetNull)
  appointment    Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  encounter      ClinicalEncounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  items          LaboratoryOrderItem[]
  samples        LaboratorySample[]
  reports        LaboratoryReport[]
  invoices       Invoice[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId])
  @@index([orderingDoctorId])
  @@index([appointmentId])
  @@index([encounterId])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("laboratory_orders")
}

/// Line items within a laboratory order with immutable price snapshotting
model LaboratoryOrderItem {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  testId           String   @map("test_id")
  packageId        String?  @map("package_id")
  testNameSnapshot String   @map("test_name_snapshot")
  testCodeSnapshot String   @map("test_code_snapshot")
  priceSnapshot    Float    @map("price_snapshot")
  status           String   @default("PENDING") // PENDING, SAMPLE_COLLECTED, PROCESSING, COMPLETED, CANCELLED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order   LaboratoryOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test    LaboratoryTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  package LaboratoryPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  result  LaboratoryResult?

  @@index([orderId])
  @@index([testId])
  @@index([packageId])
  @@index([status])
  @@map("laboratory_order_items")
}

/// Physical specimens / samples collected from patients
model LaboratorySample {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  clinicId               String    @map("clinic_id")
  orderId                String    @map("order_id")
  sampleReference        String    @unique @map("sample_reference") // e.g. SMP-202611-0089
  sampleType             String    @map("sample_type") // Blood, Urine, Serum, Sputum, etc.
  sampleStatus           String    @default("PENDING") @map("sample_status") // PENDING, COLLECTED, RECEIVED, PROCESSING, ACCEPTED, REJECTED, RECOLLECTION_REQUIRED, COMPLETED
  collectionInstructions String?   @map("collection_instructions")
  collectedById          String?   @map("collected_by_id")
  collectedAt            DateTime? @map("collected_at")
  receivedById           String?   @map("received_by_id")
  receivedAt             DateTime? @map("received_at")
  rejectionReason        String?   @map("rejection_reason")
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  order        LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedBy  UserProfile? @relation("CollectedSamples", fields: [collectedById], references: [id], onDelete: SetNull)
  receivedBy   UserProfile? @relation("ReceivedSamples", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clinicId])
  @@index([orderId])
  @@index([sampleStatus])
  @@map("laboratory_samples")
}

/// Recorded diagnostic test results entered by laboratory technicians
model LaboratoryResult {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String   @map("clinic_id")
  orderItemId    String   @unique @map("order_item_id")
  resultType     String   @default("NUMERIC") @map("result_type") // NUMERIC, TEXT, QUALITATIVE, STRUCTURED
  resultValue    String   @map("result_value")
  unit           String?
  referenceRange String?  @map("reference_range")
  resultNotes    String?  @map("result_notes")
  resultStatus   String   @default("ENTERED") @map("result_status") // PENDING, ENTERED, AMENDED, UNDER_REVIEW, APPROVED, REJECTED
  enteredById    String   @map("entered_by_id")
  enteredAt      DateTime @default(now()) @map("entered_at")
  amendedReason  String?  @map("amended_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  orderItem    LaboratoryOrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  enteredBy    UserProfile              @relation(fields: [enteredById], references: [id], onDelete: Cascade)
  reviews      LaboratoryResultReview[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([orderItemId])
  @@index([resultStatus])
  @@map("laboratory_results")
}

/// Reviewer/Pathologist evaluation decision on test results
model LaboratoryResultReview {
  id         String   @id @default(uuid())
  resultId   String   @map("result_id")
  reviewerId String   @map("reviewer_id")
  decision   String   @default("APPROVED") // APPROVED, REJECTED, AMENDMENT_REQUESTED
  comments   String?
  reviewedAt DateTime @default(now()) @map("reviewed_at")

  result   LaboratoryResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  reviewer UserProfile      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([reviewerId])
  @@index([decision])
  @@map("laboratory_result_reviews")
}

/// Finalized or uploaded PDF diagnostic reports
model LaboratoryReport {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  clinicId        String    @map("clinic_id")
  orderId         String    @map("order_id")
  reportReference String    @unique @map("report_reference") // e.g. REP-202611-0023
  version         Int       @default(1)
  storagePath     String    @map("storage_path")
  fileName        String    @map("file_name")
  fileSizeBytes   Int       @default(0) @map("file_size_bytes")
  mimeType        String    @default("application/pdf") @map("mime_type")
  reportStatus    String    @default("DRAFT") @map("report_status") // DRAFT, PENDING_REVIEW, REJECTED, APPROVED, READY_FOR_RELEASE, RELEASED, SUPERSEDED, CANCELLED
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  releasedById    String?   @map("released_by_id")
  releasedAt      DateTime? @map("released_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  order        LaboratoryOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approvedBy   UserProfile?                  @relation("ApprovedReports", fields: [approvedById], references: [id], onDelete: SetNull)
  releasedBy   UserProfile?                  @relation("ReleasedReports", fields: [releasedById], references: [id], onDelete: SetNull)
  accessTokens LaboratoryReportAccessToken[]
  accessLogs   LaboratoryReportAccessLog[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([orderId])
  @@index([reportStatus])
  @@index([createdAt])
  @@map("laboratory_reports")
}

/// High-entropy, short-lived, unguessable access tokens for secure patient report delivery
model LaboratoryReportAccessToken {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  clinicId       String    @map("clinic_id")
  reportId       String    @map("report_id")
  patientId      String    @map("patient_id")
  tokenHash      String    @unique @map("token_hash") // SHA-256 hash of plaintext access token
  tokenPrefix    String    @map("token_prefix") // First 8 chars for audit display
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  accessCount    Int       @default(0) @map("access_count")
  maxAccessCount Int       @default(10) @map("max_access_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  report       LaboratoryReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  patient      Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  accessLogs   LaboratoryReportAccessLog[]

  @@index([reportId])
  @@index([patientId])
  @@index([tokenPrefix])
  @@index([expiresAt])
  @@map("laboratory_report_access_tokens")
}

/// Access log auditing every view, download, or failed token attempt
model LaboratoryReportAccessLog {
  id           String   @id @default(uuid())
  reportId     String   @map("report_id")
  patientId    String?  @map("patient_id")
  tokenId      String?  @map("token_id")
  accessStatus String   @map("access_status") // SUCCESS, EXPIRED, REVOKED, INVALID_VERIFICATION, ACCESS_LIMIT_EXCEEDED
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?    @default("{}")
  accessedAt   DateTime @default(now()) @map("accessed_at")

  report LaboratoryReport             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  token  LaboratoryReportAccessToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([patientId])
  @@index([accessStatus])
  @@index([accessedAt])
  @@map("laboratory_report_access_logs")
}

/// Dedicated audit trail for sensitive laboratory operations
model LaboratoryAuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  actorId        String   @map("actor_id")
  entityType     String   @map("entity_type") // TEST, PACKAGE, ORDER, SAMPLE, RESULT, REPORT
  entityId       String   @map("entity_id")
  action         String   // CREATED, UPDATED, STATUS_CHANGED, REVIEWED, APPROVED, RELEASED, REVOKED
  previousValues Json?    @default("{}") @map("previous_values")
  newValues      Json?    @default("{}") @map("new_values")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("laboratory_audit_logs")
}

// ==========================================
// Phase 11: Financial Management, Billing, Invoicing & Payments
// ==========================================

/// Outpatient, consultation, and diagnostic patient invoices
model Invoice {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  clinicId           String    @map("clinic_id")
  patientId          String    @map("patient_id")
  appointmentId      String?   @map("appointment_id")
  laboratoryOrderId  String?   @map("laboratory_order_id")
  encounterId        String?   @map("encounter_id")
  invoiceReference   String    @unique @map("invoice_reference") // INV-YYYYMM-XXXX
  relatedEntityType  String?   @map("related_entity_type") // APPOINTMENT, LABORATORY_ORDER, CONSULTATION, GENERAL
  relatedEntityId    String?   @map("related_entity_id")
  subtotalMinor      Int       @default(0) @map("subtotal_minor")
  discountMinor      Int       @default(0) @map("discount_minor")
  discountType       String?   @map("discount_type") // FIXED, PERCENTAGE
  discountReason     String?   @map("discount_reason")
  taxMinor           Int       @default(0) @map("tax_minor")
  taxRatePercent     Float     @default(0) @map("tax_rate_percent")
  totalMinor         Int       @default(0) @map("total_minor")
  paidMinor          Int       @default(0) @map("paid_minor")
  outstandingMinor   Int       @default(0) @map("outstanding_minor")
  currency           String    @default("PKR")
  status             String    @default("DRAFT") @map("status") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, VOIDED
  issuedAt           DateTime? @map("issued_at")
  dueAt              DateTime? @map("due_at")
  createdById        String?   @map("created_by_id")
  cancellationReason String?   @map("cancellation_reason")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic             Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient            Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment        Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  laboratoryOrder    LaboratoryOrder?       @relation(fields: [laboratoryOrderId], references: [id], onDelete: SetNull)
  encounter          ClinicalEncounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy          UserProfile?           @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items              InvoiceItem[]
  payments           Payment[]
  allocations        PaymentAllocation[]
  refunds            Refund[]
  adjustments        FinancialAdjustment[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
  @@index([createdAt])
  @@map("invoices")
}

/// Line items within an invoice with immutable price snapshotting
model InvoiceItem {
  id                  String   @id @default(uuid())
  invoiceId           String   @map("invoice_id")
  itemType            String   @map("item_type") // CONSULTATION, LAB_TEST, LAB_PACKAGE, PROCEDURE, MEDICATION, SERVICE, CUSTOM
  itemReference       String?  @map("item_reference")
  descriptionSnapshot String   @map("description_snapshot")
  quantity            Int      @default(1)
  unitPriceMinor      Int      @map("unit_price_minor")
  discountMinor       Int      @default(0) @map("discount_minor")
  taxMinor            Int      @default(0) @map("tax_minor")
  totalMinor          Int      @map("total_minor")
  createdAt           DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemType])
  @@map("invoice_items")
}

/// Patient payments and collections against invoices
model Payment {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  clinicId              String    @map("clinic_id")
  invoiceId             String    @map("invoice_id")
  patientId             String?   @map("patient_id")
  paymentReference      String    @unique @map("payment_reference") // PAY-YYYYMM-XXXX
  method                String    @map("method") // CASH, BANK_TRANSFER, CARD, RAAST, OTHER
  provider              String    @default("CASH") @map("provider") // CASH, MANUAL_BANK, RAAST_SBP, PAYMOB, SAFEPAY, STRIPE
  providerTransactionId String?   @map("provider_transaction_id")
  amountMinor           Int       @map("amount_minor")
  currency              String    @default("PKR")
  status                String    @default("COMPLETED") @map("status") // PENDING, COMPLETED, FAILED, REVERSED, REFUNDED
  idempotencyKey        String?   @unique @map("idempotency_key")
  collectedById         String?   @map("collected_by_id")
  confirmedAt           DateTime? @map("confirmed_at")
  bankName              String?   @map("bank_name")
  bankReference         String?   @map("bank_reference")
  cardLast4             String?   @map("card_last4")
  cardBrand             String?   @map("card_brand")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice      Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient      Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  collectedBy  UserProfile?        @relation("PaymentCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)
  allocations  PaymentAllocation[]
  refunds      Refund[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([invoiceId])
  @@index([patientId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@map("payments")
}

/// Allocation ledger mapping payments to specific invoices
model PaymentAllocation {
  id             String   @id @default(uuid())
  paymentId      String   @map("payment_id")
  invoiceId      String   @map("invoice_id")
  allocatedMinor Int      @map("allocated_minor")
  createdAt      DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// Financial refund records with approval lifecycle
model Refund {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  clinicId         String    @map("clinic_id")
  paymentId        String    @map("payment_id")
  invoiceId        String    @map("invoice_id")
  refundReference  String    @unique @map("refund_reference") // REF-YYYYMM-XXXX
  amountMinor      Int       @map("amount_minor")
  currency         String    @default("PKR")
  reason           String
  status           String    @default("PENDING_APPROVAL") @map("status") // REQUESTED, PENDING_APPROVAL, APPROVED, PROCESSING, COMPLETED, FAILED, REJECTED
  requestedById    String    @map("requested_by_id")
  approvedById     String?   @map("approved_by_id")
  rejectionReason  String?   @map("rejection_reason")
  providerRefundId String?   @map("provider_refund_id")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([status])
  @@map("refunds")
}

/// Adjustments, write-offs, and credit notes against invoices
model FinancialAdjustment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String   @map("clinic_id")
  invoiceId      String   @map("invoice_id")
  adjustmentType String   @map("adjustment_type") // CREDIT_NOTE, WRITE_OFF, MANUAL_CORRECTION, DISCOUNT_ADJUSTMENT
  amountMinor    Int      @map("amount_minor")
  reason         String
  approvedById   String?  @map("approved_by_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([invoiceId])
  @@map("financial_adjustments")
}

/// Categories for operating expenses
model ExpenseCategory {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String
  description    String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("expense_categories")
}

/// Operational clinic expenses
model Expense {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  clinicId         String    @map("clinic_id")
  categoryId       String    @map("category_id")
  expenseReference String    @unique @map("expense_reference") // EXP-YYYYMM-XXXX
  description      String
  amountMinor      Int       @map("amount_minor")
  currency         String    @default("PKR")
  paymentMethod    String    @default("CASH") @map("payment_method") // CASH, BANK_TRANSFER, CARD, CHEQUE, OTHER
  vendor           String?
  referenceNumber  String?   @map("reference_number")
  expenseDate      DateTime  @map("expense_date")
  status           String    @default("APPROVED") @map("status") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, PAID
  createdById      String    @map("created_by_id")
  approvedById     String?   @map("approved_by_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

/// Physical cash register sessions and daily financial closing
model CashRegisterSession {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  clinicId             String    @map("clinic_id")
  sessionNumber        String    @unique @map("session_number") // CRS-YYYYMM-XXXX
  openedById           String    @map("opened_by_id")
  closedById           String?   @map("closed_by_id")
  openingBalanceMinor  Int       @default(0) @map("opening_balance_minor")
  expectedClosingMinor Int       @default(0) @map("expected_closing_minor")
  actualClosingMinor   Int?      @map("actual_closing_minor")
  discrepancyMinor     Int?      @map("discrepancy_minor")
  discrepancyReason    String?   @map("discrepancy_reason")
  status               String    @default("OPEN") @map("status") // OPEN, CLOSED, REOPENED_AUDIT
  openedAt             DateTime  @default(now()) @map("opened_at")
  closedAt             DateTime? @map("closed_at")
  reopenedAt           DateTime? @map("reopened_at")
  reopenedById         String?   @map("reopened_by_id")
  reopenReason         String?   @map("reopen_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  openedBy     UserProfile                 @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  closedBy     UserProfile?                @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  transactions CashRegisterTransaction[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_register_sessions")
}

/// Cash movements associated with a cash register session
model CashRegisterTransaction {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  transactionType String   @map("transaction_type") // CASH_PAYMENT, CASH_REFUND, CASH_EXPENSE, CASH_DEPOSIT, CASH_WITHDRAWAL, MANUAL_ADJUSTMENT
  referenceType   String?  @map("reference_type") // PAYMENT, REFUND, EXPENSE, MANUAL
  referenceId     String?  @map("reference_id")
  amountMinor     Int      @map("amount_minor") // positive for cash in, negative for cash out
  recordedById    String   @map("recorded_by_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  session CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("cash_register_transactions")
}

/// Incoming webhook logs for external payment providers
model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payloadMetadata Json      @default("{}") @map("payload_metadata")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

/// Immutable audit ledger for financial operations and mutations
model FinancialAuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  actorId        String   @map("actor_id")
  entityType     String   @map("entity_type") // INVOICE, PAYMENT, REFUND, EXPENSE, CASH_REGISTER, ADJUSTMENT
  entityId       String   @map("entity_id")
  action         String   // CREATED, ISSUED, PAID, REFUNDED, CANCELLED, VOIDED, CLOSED, REOPENED, AMENDED
  previousValues Json?    @default("{}") @map("previous_values")
  newValues      Json?    @default("{}") @map("new_values")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("financial_audit_logs")
}

// ==========================================
// Phase 12: Clinical Encounter & EMR-Lite Models
// ==========================================

/// Core patient clinical consultation encounter
model ClinicalEncounter {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  clinicId           String    @map("clinic_id")
  patientId          String    @map("patient_id")
  doctorId           String    @map("doctor_id")
  appointmentId      String?   @map("appointment_id")
  queueTokenId       String?   @map("queue_token_id")
  encounterReference String    @unique @map("encounter_reference") // ENC-YYYYMM-XXXX
  encounterDate      String    @map("encounter_date") // YYYY-MM-DD
  startTime          String    @map("start_time") // HH:mm
  endTime            String?   @map("end_time") // HH:mm
  timezone           String    @default("Asia/Karachi")
  status             String    @default("SCHEDULED") @map("status") // SCHEDULED, CHECKED_IN, IN_PROGRESS, PENDING_REVIEW, COMPLETED, CANCELLED
  source             String    @default("WALK_IN") @map("source") // APPOINTMENT, WALK_IN, DOCTOR_INITIATED, RECEPTIONIST_ASSISTED
  type               String    @default("GENERAL_CONSULTATION") @map("type") // GENERAL_CONSULTATION, FOLLOW_UP, EMERGENCY, TELEMEDICINE, ROUTINE_CHECKUP
  isFinalized        Boolean   @default(false) @map("is_finalized")
  finalizedAt        DateTime? @map("finalized_at")
  finalizedById      String?   @map("finalized_by_id")
  cancellationReason String?   @map("cancellation_reason")
  createdById        String?   @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic           Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           Doctor                    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment      Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  queueToken       QueueToken?               @relation(fields: [queueTokenId], references: [id], onDelete: SetNull)
  statusHistory    EncounterStatusHistory[]
  clinicalNote     ClinicalNote?
  observations     PatientObservation[]
  diagnoses        EncounterDiagnosis[]
  prescriptions    Prescription[]
  laboratoryOrders LaboratoryOrder[]
  invoices         Invoice[]
  followups        EncounterFollowup[]
  amendments       EncounterAmendment[]
  documentVersions ClinicalDocumentVersion[]

  @@unique([organizationId, encounterReference])
  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([queueTokenId])
  @@index([status])
  @@index([encounterDate])
  @@index([createdAt])
  @@map("clinical_encounters")
}

/// Historical audit of clinical encounter status transitions
model EncounterStatusHistory {
  id           String   @id @default(uuid())
  encounterId  String   @map("encounter_id")
  fromStatus   String?  @map("from_status")
  toStatus     String   @map("to_status")
  changeReason String?  @map("change_reason")
  changedById  String?  @map("changed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([createdAt])
  @@map("encounter_status_history")
}

/// Structured consultation notes entered by the attending doctor
model ClinicalNote {
  id                      String   @id @default(uuid())
  encounterId             String   @unique @map("encounter_id")
  chiefComplaint          String   @map("chief_complaint")
  patientReportedSymptoms String?  @map("patient_reported_symptoms")
  visitPurpose            String?  @map("visit_purpose")
  visitContext            String?  @map("visit_context")
  examinationNotes        String?  @map("examination_notes")
  clinicalAssessment      String?  @map("clinical_assessment")
  treatmentPlan           String?  @map("treatment_plan")
  remarks                 String?
  recordedById            String?  @map("recorded_by_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("clinical_notes")
}

/// Longitudinal medical profile and clinical history for a patient
model PatientMedicalHistory {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  patientId          String   @unique @map("patient_id")
  conditions         String?  // JSON string of existing medical conditions
  surgeries          String?  // JSON string of previous surgical procedures
  allergies          String?  // JSON string of known drug/food/environmental allergies
  familyHistory      String?  @map("family_history")
  socialHistory      String?  @map("social_history")
  currentMedications String?  @map("current_medications")
  lastUpdatedById    String?  @map("last_updated_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("patient_medical_histories")
}

/// Clinical observations and vital signs recorded during an encounter
model PatientObservation {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  clinicId         String    @map("clinic_id")
  patientId        String    @map("patient_id")
  encounterId      String?   @map("encounter_id")
  systolicBp       Int?      @map("systolic_bp") // mmHg
  diastolicBp      Int?      @map("diastolic_bp") // mmHg
  pulseRate        Int?      @map("pulse_rate") // bpm
  temperature      Float?    // value
  temperatureUnit  String    @default("C") @map("temperature_unit") // C or F
  respiratoryRate  Int?      @map("respiratory_rate") // breaths/min
  oxygenSaturation Int?      @map("oxygen_saturation") // % (SpO2)
  heightCm         Float?    @map("height_cm") // cm
  weightKg         Float?    @map("weight_kg") // kg
  bmi              Float?    // Calculated only when height & weight exist
  measuredAt       DateTime  @default(now()) @map("measured_at")
  recordedById     String?   @map("recorded_by_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId])
  @@index([encounterId])
  @@index([measuredAt])
  @@map("patient_observations")
}

/// Doctor-entered diagnoses and clinical classifications
model EncounterDiagnosis {
  id                   String   @id @default(uuid())
  encounterId          String   @map("encounter_id")
  patientId            String   @map("patient_id")
  diagnosisDescription String   @map("diagnosis_description")
  diagnosisCode        String?  @map("diagnosis_code")
  codingSystem         String   @default("CUSTOM") @map("coding_system") // ICD-10, CUSTOM, NONE
  type                 String   @default("PRIMARY") // PRIMARY, SECONDARY
  clinicalStatus       String   @default("CONFIRMED") @map("clinical_status") // CONFIRMED, PROVISIONAL, DIFFERENTIAL, RESOLVED
  notes                String?
  diagnosedById        String?  @map("diagnosed_by_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([patientId])
  @@index([type])
  @@map("encounter_diagnoses")
}

/// Doctor-issued outpatient medication prescription
model Prescription {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  clinicId              String    @map("clinic_id")
  encounterId           String    @map("encounter_id")
  patientId             String    @map("patient_id")
  doctorId              String    @map("doctor_id")
  prescriptionReference String    @unique @map("prescription_reference") // RX-YYYYMM-XXXX
  version               Int       @default(1)
  status                String    @default("ACTIVE") // DRAFT, ACTIVE, AMENDED, CANCELLED, DISPENSED
  cancellationReason    String?   @map("cancellation_reason")
  notes                 String?
  issuedAt              DateTime  @default(now()) @map("issued_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  encounter    ClinicalEncounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient      Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor                  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  items        PrescriptionItem[]
  amendments   PrescriptionAmendment[]

  @@unique([organizationId, prescriptionReference])
  @@index([organizationId])
  @@index([clinicId])
  @@index([encounterId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
  @@map("prescriptions")
}

/// Prescribed pharmaceutical medication items
model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String   @map("prescription_id")
  medicationName String   @map("medication_name")
  genericName    String?  @map("generic_name")
  strength       String
  dosageForm     String   @default("Tablet") @map("dosage_form")
  dosage         String
  route          String   @default("Oral")
  frequency      String
  duration       String
  quantity       Int?
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// Audit ledger for prescription amendments and modifications
model PrescriptionAmendment {
  id               String   @id @default(uuid())
  prescriptionId   String   @map("prescription_id")
  version          Int
  reason           String
  amendedById      String   @map("amended_by_id")
  previousSnapshot String   @map("previous_snapshot") // JSON
  newSnapshot      String   @map("new_snapshot") // JSON
  createdAt        DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_amendments")
}

/// Doctor-scheduled follow-up consultation records
model EncounterFollowup {
  id                     String   @id @default(uuid())
  encounterId            String   @map("encounter_id")
  clinicId               String   @map("clinic_id")
  patientId              String   @map("patient_id")
  doctorId               String   @map("doctor_id")
  followupRequired       Boolean  @default(true) @map("followup_required")
  recommendedDate        String   @map("recommended_date") // YYYY-MM-DD
  instructions           String
  status                 String   @default("PENDING") // PENDING, SCHEDULED, COMPLETED, CANCELLED
  scheduledAppointmentId String?  @map("scheduled_appointment_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([recommendedDate])
  @@index([status])
  @@map("encounter_followups")
}

/// Immutable audit record of authorized post-finalization encounter amendments
model EncounterAmendment {
  id                String   @id @default(uuid())
  encounterId       String   @map("encounter_id")
  versionNumber     Int      @map("version_number")
  amendmentReason   String   @map("amendment_reason")
  amendedById       String   @map("amended_by_id")
  previousStateJson String   @map("previous_state_json")
  amendedStateJson  String   @map("amended_state_json")
  createdAt         DateTime @default(now()) @map("created_at")

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("encounter_amendments")
}

/// Immutable clinical document versions generated upon encounter finalization
model ClinicalDocumentVersion {
  id            String    @id @default(uuid())
  encounterId   String    @map("encounter_id")
  documentType  String    @map("document_type") // ENCOUNTER_SUMMARY, PRESCRIPTION, DISCHARGE_SUMMARY
  versionNumber Int       @map("version_number")
  documentTitle String    @map("document_title")
  contentJson   String    @map("content_json")
  isFinal       Boolean   @default(true) @map("is_final")
  signedById    String?   @map("signed_by_id")
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("clinical_document_versions")
}

// ==========================================
// Phase 13: Advanced Analytics & BI Models
// ==========================================

/// Custom saved report configurations created via Report Builder
model SavedReportConfiguration {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  name           String
  description    String?
  category       String   // EXECUTIVE, APPOINTMENTS, QUEUE, PATIENTS, STAFF, LABORATORY, FINANCE, COMMUNICATIONS, AI_USAGE
  dimensions     Json     @default("[]") // array of dimension keys
  metrics        Json     @default("[]") // array of metric keys
  filtersJson    Json     @default("{}") @map("filters_json") // applied filter state
  grouping       String?  // DAY, WEEK, MONTH, DOCTOR, CLINIC, STATUS, CATEGORY, TENDER
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic           Clinic?           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy        UserProfile       @relation("ReportConfigCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  scheduledReports ScheduledReport[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([category])
  @@map("saved_report_configurations")
}

/// Automated recurring scheduled reports
model ScheduledReport {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  clinicId              String?   @map("clinic_id")
  reportConfigurationId String    @map("report_configuration_id")
  name                  String
  frequency             String    // DAILY, WEEKLY, MONTHLY
  recipients            String[]  // array of target email addresses or user IDs
  exportFormat          String    @default("PDF") @map("export_format") // PDF, CSV, XLSX
  status                String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  lastRunAt             DateTime? @map("last_run_at")
  nextRunAt             DateTime? @map("next_run_at")
  createdById           String    @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic              Clinic?                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  reportConfiguration SavedReportConfiguration @relation(fields: [reportConfigurationId], references: [id], onDelete: Cascade)
  createdBy           UserProfile              @relation("ScheduledReportCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  runs                ScheduledReportRun[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([frequency])
  @@index([status])
  @@map("scheduled_reports")
}

/// Execution history and delivery status for scheduled reports
model ScheduledReportRun {
  id                  String    @id @default(uuid())
  scheduledReportId   String    @map("scheduled_report_id")
  organizationId      String    @map("organization_id")
  runStatus           String    @default("PENDING") @map("run_status") // PENDING, SUCCESS, FAILED
  rowCount            Int       @default(0) @map("row_count")
  recipientsDelivered String[]  @map("recipients_delivered")
  failureReason       String?   @map("failure_reason")
  executionDurationMs Int       @default(0) @map("execution_duration_ms")
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")

  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId])
  @@index([organizationId])
  @@index([runStatus])
  @@map("scheduled_report_runs")
}

/// Audit log of generated report downloads and exports (PDF/CSV/XLSX)
model AnalyticsExportLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
