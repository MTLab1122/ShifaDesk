/// Scheduled, pending, and dispatched notification jobs
model NotificationJob {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  clinicId          String    @map("clinic_id")
  recipientId       String    @map("recipient_id") // Patient ID, User ID, or E.164 phone
  recipientType     String    @default("PATIENT") @map("recipient_type") // PATIENT, STAFF, CONTACT
  eventType         String    @map("event_type")
  channel           String    // WHATSAPP, IN_APP, EMAIL, SMS
  templateId        String?   @map("template_id")
  relatedEntityType String?   @map("related_entity_type") // APPOINTMENT, QUEUE_TOKEN, QUEUE_SESSION, CONVERSATION
  relatedEntityId   String?   @map("related_entity_id")
  scheduledAt       DateTime  @default(now()) @map("scheduled_at")
  status            String    @default("PENDING") // PENDING, SCHEDULED, PROCESSING, SENT, DELIVERED, READ, FAILED, RETRYING, DEAD_LETTER, CANCELLED, SUPPRESSED
  idempotencyKey    String    @unique @map("idempotency_key")
  payload           Json      @default("{}")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3) @map("max_attempts")
  lastError         String?   @map("last_error")
  suppressionReason String?   @map("suppression_reason")
  claimedAt         DateTime? @map("claimed_at")
  claimedBy         String?   @map("claimed_by") // Worker instance id
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attemptLogs  NotificationAttempt[]
  eventLogs    NotificationEvent[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([recipientId])
  @@index([status])
  @@index([scheduledAt])
  @@index([eventType])
  @@index([relatedEntityType, relatedEntityId])
  @@map("notification_jobs")
}

/// Audit ledger of individual delivery attempts for a notification job
model NotificationAttempt {
  id                String    @id @default(uuid())
  notificationJobId String    @map("notification_job_id")
  channel           String    // WHATSAPP, IN_APP, EMAIL, SMS
  provider          String    // meta_cloud_api, in_app, mock_smtp, mock_sms
  providerMessageId String?   @map("provider_message_id")
  attemptNumber     Int       @map("attempt_number")
  status            String    // SUCCESS, TEMPORARY_FAILURE, PERMANENT_FAILURE
  responseMetadata  Json?     @map("response_metadata")
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message")
  attemptedAt       DateTime  @default(now()) @map("attempted_at")
  completedAt       DateTime? @map("completed_at")

  job NotificationJob @relation(fields: [notificationJobId], references: [id], onDelete: Cascade)

  @@index([notificationJobId])
  @@index([status])
  @@index([attemptedAt])
  @@map("notification_attempts")
}

/// Granular delivery and lifecycle events for notification job observability
model NotificationEvent {
  id                String   @id @default(uuid())
  notificationJobId String   @map("notification_job_id")
  eventType         String   @map("event_type") // QUEUED, CLAIMED, DISPATCHED, DELIVERED, READ, FAILED, RETRY_SCHEDULED, DEAD_LETTERED, CANCELLED, SUPPRESSED
