  scheduleOffsetMinutes Int      @default(0) @map("schedule_offset_minutes") // -1440 = 24h before, -120 = 2h before, 0 = immediate
  priority              String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  quietHoursPolicy      String   @default("ALLOW_IMMEDIATE") @map("quiet_hours_policy") // ALLOW_IMMEDIATE, QUEUE_UNTIL_MORNING, SUPPRESS
  fallbackPolicy        String   @default("NONE") @map("fallback_policy") // NONE, IN_APP, SMS, EMAIL
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clinicId])
  @@index([eventType])
  @@index([channel])
  @@index([enabled])
  @@map("notification_rules")
}

