  @@index([organizationId])
  @@index([clinicId])
  @@index([dashboardView])
  @@index([accessedById])
  @@index([accessedAt])
  @@map("analytics_access_logs")
}

/// ============================================================================
/// PHASE 14: SAAS SUBSCRIPTION, TENANT ONBOARDING & PLATFORM ADMINISTRATION
/// ============================================================================

/// Configurable platform subscription plans (Starter, Professional, Laboratory, etc.)
model SubscriptionPlan {
  id                String   @id @default(uuid())
  name              String
  code              String   @unique
  description       String?
  monthlyPricePaisa Int      @map("monthly_price_paisa")
  annualPricePaisa  Int      @map("annual_price_paisa")
  currency          String   @default("PKR")
  trialDays         Int      @default(14) @map("trial_days")
  isActive          Boolean  @default(true) @map("is_active")
  displayOrder      Int      @default(0) @map("display_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  versions          SubscriptionPlanVersion[]
  subscriptions     TenantSubscription[]
  trialRecords      TrialRecord[]

  @@index([code])
  @@index([isActive])
  @@map("subscription_plans")
}

/// Versioned subscription plan specifications preserving historical pricing
model SubscriptionPlanVersion {
  id                String   @id @default(uuid())
  planId            String   @map("plan_id")
  version           Int      @default(1)
  monthlyPricePaisa Int      @map("monthly_price_paisa")
  annualPricePaisa  Int      @map("annual_price_paisa")
  currency          String   @default("PKR")
  effectiveFrom     DateTime @default(now()) @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  features          Json     @default("[]")
  limits            Json     @default("{}")
  overagePolicy     String   @default("BLOCK") @map("overage_policy")
  gracePeriodDays   Int      @default(7) @map("grace_period_days")
  createdAt         DateTime @default(now()) @map("created_at")

  plan              SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlements      PlanEntitlement[]
  subscriptions     TenantSubscription[]

  @@unique([planId, version])
  @@index([planId])
  @@map("subscription_plan_versions")
}

/// Feature entitlements configured for a specific plan version
model PlanEntitlement {
  id            String   @id @default(uuid())
  planVersionId String   @map("plan_version_id")
  featureCode   String   @map("feature_code")
  isIncluded    Boolean  @default(true) @map("is_included")
  limitType     String   @default("UNLIMITED") @map("limit_type") // UNLIMITED, COUNT, BOOLEAN
  limitValue    Int      @default(0) @map("limit_value")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  planVersion   SubscriptionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, featureCode])
  @@index([planVersionId])
  @@index([featureCode])
  @@map("plan_entitlements")
}

/// Active and historical subscription instances for organizations/tenants
model TenantSubscription {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  planId             String   @map("plan_id")
  planVersionId      String   @map("plan_version_id")
  status             String   @default("TRIALING") // PENDING, TRIALING, ACTIVE, PAST_DUE, GRACE_PERIOD, SUSPENDED, CANCELLED, EXPIRED
  billingInterval    String   @default("MONTHLY") @map("billing_interval") // MONTHLY, ANNUAL
  currentPeriodStart DateTime @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  trialStart         DateTime? @map("trial_start")
  trialEnd           DateTime? @map("trial_end")
  gracePeriodEnd     DateTime? @map("grace_period_end")
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?  @map("cancellation_reason")
  unitPricePaisa     Int      @default(0) @map("unit_price_paisa")
  currency           String   @default("PKR")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan         @relation(fields: [planId], references: [id])
  planVersion        SubscriptionPlanVersion  @relation(fields: [planVersionId], references: [id])
  invoices           SubscriptionInvoice[]
  statusHistories    SubscriptionStatusHistory[]

  @@index([organizationId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("tenant_subscriptions")
}

/// Audit ledger for subscription lifecycle status transitions
model SubscriptionStatusHistory {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  reason         String?
  changedById    String?  @map("changed_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_status_histories")
}

/// SaaS subscription invoices issued to tenant organizations (SUB-YYYYMM-XXXX)
model SubscriptionInvoice {
  id                  String   @id @default(uuid())
  invoiceNumber       String   @unique @map("invoice_number")
  organizationId      String   @map("organization_id")
  subscriptionId      String?  @map("subscription_id")
  planVersionSnapshot Json     @map("plan_version_snapshot")
  status              String   @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, VOIDED
  billingPeriodStart  DateTime @map("billing_period_start")
  billingPeriodEnd    DateTime @map("billing_period_end")
  currency            String   @default("PKR")
  subtotalPaisa       Int      @default(0) @map("subtotal_paisa")
  discountPaisa       Int      @default(0) @map("discount_paisa")
  taxPaisa            Int      @default(0) @map("tax_paisa")
  totalPaisa          Int      @default(0) @map("total_paisa")
  amountPaidPaisa     Int      @default(0) @map("amount_paid_paisa")
  outstandingPaisa    Int      @default(0) @map("outstanding_paisa")
  issueDate           DateTime @default(now()) @map("issue_date")
  dueDate             DateTime @map("due_date")
  paidAt              DateTime? @map("paid_at")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription        TenantSubscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items               SubscriptionInvoiceItem[]
  payments            SubscriptionPayment[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@map("subscription_invoices")
}

/// Line items on SaaS subscription invoices
model SubscriptionInvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String   @map("invoice_id")
  description    String
  itemType       String   @default("PLAN_FEE") @map("item_type") // PLAN_FEE, USAGE_OVERAGE, DISCOUNT_CREDIT, ADJUSTMENT
  quantity       Int      @default(1)
  unitPricePaisa Int      @default(0) @map("unit_price_paisa")
  totalPricePaisa Int     @default(0) @map("total_price_paisa")
  createdAt      DateTime @default(now()) @map("created_at")

  invoice        SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("subscription_invoice_items")
}

/// SaaS subscription payments made by tenant organizations (SPAY-YYYYMM-XXXX)
model SubscriptionPayment {
  id                    String   @id @default(uuid())
  paymentNumber         String   @unique @map("payment_number")
  invoiceId             String   @map("invoice_id")
  organizationId        String   @map("organization_id")
  amountPaisa           Int      @map("amount_paisa")
  currency              String   @default("PKR")
  paymentMethod         String   @map("payment_method") // MANUAL_BANK_TRANSFER, CARD, RAAST, PROMOTIONAL_CREDIT
  status                String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, REVERSED, REFUNDED
  provider              String   @default("MANUAL") // MANUAL, SAFEPAY, RAAST, PROMO
  providerTransactionId String?  @map("provider_transaction_id")
  paymentReference      String?  @map("payment_reference")
  proofDocumentUrl      String?  @map("proof_document_url")
  verifiedById          String?  @map("verified_by_id")
  verifiedAt            DateTime? @map("verified_at")
  rejectionReason       String?  @map("rejection_reason")
  idempotencyKey        String?  @unique @map("idempotency_key")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  invoice               SubscriptionInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifiedBy            UserProfile?              @relation("SubscriptionPaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  events                SubscriptionPaymentEvent[]

  @@index([invoiceId])
  @@index([organizationId])
  @@index([status])
  @@index([paymentReference])
  @@map("subscription_payments")
}

/// Ledger for webhook events and gateway callbacks for subscription payments
model SubscriptionPaymentEvent {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  eventType  String   @map("event_type")
  payload    Json
  signature  String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  payment    SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventType])
  @@map("subscription_payment_events")
}

/// Tenant-specific feature entitlement overrides granted by platform administrators
model TenantEntitlementOverride {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  featureCode    String   @map("feature_code")
  isIncluded     Boolean  @default(true) @map("is_included")
  limitValue     Int?     @map("limit_value")
  grantedReason  String   @map("granted_reason")
  expiresAt      DateTime? @map("expires_at")
  grantedById    String   @map("granted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy      UserProfile  @relation("EntitlementOverrideGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureCode])
  @@index([organizationId])
  @@index([featureCode])
  @@map("tenant_entitlement_overrides")
}

/// Centralized metered usage events across tenant features
model UsageEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  featureCode    String   @map("feature_code")
  quantity       Int      @default(1)
  source         String   // SYSTEM, APPOINTMENT, QUEUE, WHATSAPP, VOICE, LAB, EMR
  idempotencyKey String?  @unique @map("idempotency_key")
  metadata       Json     @default("{}")
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic         Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([featureCode])
  @@index([timestamp])
  @@map("usage_events")
}

/// Aggregated usage per billing cycle per feature
model UsagePeriodSummary {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  billingPeriodStart DateTime @map("billing_period_start")
  billingPeriodEnd   DateTime @map("billing_period_end")
  featureCode        String   @map("feature_code")
  totalUsage         Int      @default(0) @map("total_usage")
  limitValue         Int      @default(0) @map("limit_value")
  isExceeded         Boolean  @default(false) @map("is_exceeded")
  lastAggregatedAt   DateTime @default(now()) @map("last_aggregated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, billingPeriodStart, billingPeriodEnd, featureCode])
  @@index([organizationId])
  @@index([featureCode])
  @@map("usage_period_summaries")
}

/// Free trial eligibility and lifecycle tracking per tenant
model TrialRecord {
  id              String   @id @default(uuid())
  organizationId  String   @unique @map("organization_id")
  userProfileId   String   @map("user_profile_id")
  planId          String   @map("plan_id")
  startedAt       DateTime @default(now()) @map("started_at")
  expiresAt       DateTime @map("expires_at")
  extendedDays    Int      @default(0) @map("extended_days")
  extensionReason String?  @map("extension_reason")
  status          String   @default("ACTIVE") // ACTIVE, CONVERTED, EXPIRED, TERMINATED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfile     UserProfile      @relation("TrialRecordUser", fields: [userProfileId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([userProfileId])
  @@index([status])
  @@map("trial_records")
}

/// Promotional credits and discount balances applicable to SaaS subscription invoices
model PromotionalCredit {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String   @unique
  amountPaisa    Int      @map("amount_paisa")
  remainingPaisa Int      @map("remaining_paisa")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean  @default(true) @map("is_active")
  grantedById    String   @map("granted_by_id")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy      UserProfile  @relation("PromotionalCreditGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([code])
  @@index([isActive])
  @@map("promotional_credits")
}

/// Tamper-evident audit log for Super-Admin platform operations
model PlatformAdminAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String   @map("actor_user_id")
  action       String   // TENANT_SUSPENDED, TRIAL_EXTENDED, PLAN_CREATED, PAYMENT_VERIFIED, OVERRIDE_GRANTED
  resourceType String   @map("resource_type") // Tenant, SubscriptionPlan, SubscriptionPayment, TenantSubscription
  resourceId   String   @map("resource_id")
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actor        UserProfile @relation("PlatformAdminActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("platform_admin_audit_logs")
}




