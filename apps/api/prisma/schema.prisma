datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Foundational system connectivity check table
model SystemHealthCheck {
  id        String   @id @default(uuid())
  checkKey  String   @unique @map("check_key")
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @updatedAt @map("checked_at")

  @@map("system_health_checks")
}

/// Organization entity representing multi-tenant healthcare boundary
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinics                   Clinic[]
  memberships               OrganizationMembership[]
  auditLogs                 AuditLog[]
  doctors                   Doctor[]
  staffMembers              StaffMember[]
  patients                  Patient[]
  doctorAssignments         DoctorClinicAssignment[]
  doctorWorkingHours        DoctorWorkingHours[]
  doctorScheduleExceptions  DoctorScheduleException[]
  appointments              Appointment[]
  appointmentStatusHistories AppointmentStatusHistory[]
  queueSettings             ClinicQueueSettings[]
  queueSessions             ClinicQueueSession[]
  queueTokens               QueueToken[]
  queueStatusHistories      QueueStatusHistory[]
  whatsappIntegrations      WhatsappIntegration[]
  whatsappContacts          WhatsappContact[]
  whatsappConversations     WhatsappConversation[]
  whatsappMessages          WhatsappMessage[]
  whatsappMessageTemplates  WhatsappMessageTemplate[]
  aiAssistantSettings       AiAssistantSettings[]
  aiConversationStates      AiConversationState[]
  aiInteractionLogs         AiInteractionLog[]
  clinicFaqs                ClinicFaq[]
  aiToolExecutionLogs       AiToolExecutionLog[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

/// Physical or branch clinic facility under an organization
model Clinic {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  address        String?
  phone          String?
  email          String?
  timezone       String   @default("Asia/Karachi")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships                ClinicMembership[]
  auditLogs                  AuditLog[]
  doctors                    Doctor[]
  staffMembers               StaffMember[]
  patients                   Patient[]
  doctorAssignments          DoctorClinicAssignment[]
  doctorWorkingHours         DoctorWorkingHours[]
  doctorScheduleExceptions   DoctorScheduleException[]
  appointments               Appointment[]
  appointmentStatusHistories AppointmentStatusHistory[]
  queueSettings              ClinicQueueSettings[]
  queueSessions              ClinicQueueSession[]
  queueTokens                QueueToken[]
  queueStatusHistories       QueueStatusHistory[]
  whatsappIntegration        WhatsappIntegration?
  whatsappContacts           WhatsappContact[]
  whatsappConversations      WhatsappConversation[]
  whatsappMessages           WhatsappMessage[]
  whatsappMessageTemplates   WhatsappMessageTemplate[]
  aiAssistantSettings        AiAssistantSettings?
  aiConversationStates       AiConversationState[]
  aiInteractionLogs          AiInteractionLog[]
  clinicFaqs                 ClinicFaq[]
  aiToolExecutionLogs        AiToolExecutionLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("clinics")
}

/// Application user profile linked to Supabase Auth identity
model UserProfile {
  id         String   @id @default(uuid())
  authUserId String   @unique @map("auth_user_id")
  fullName   String   @map("full_name")
  email      String   @unique
  phone      String?
  avatarUrl  String?  @map("avatar_url")
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  organizationMemberships OrganizationMembership[]
  clinicMemberships       ClinicMembership[]
  auditLogs               AuditLog[]
  doctors                 Doctor[]
  staffMembers            StaffMember[]
  patients                Patient[]
  assignedWhatsappConversations WhatsappConversation[]

  @@index([authUserId])
  @@index([email])
  @@map("user_profiles")
}

/// Organization membership linking a user profile with organization-level role
model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userProfileId  String   @map("user_profile_id")
  role           String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfile  UserProfile  @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userProfileId])
  @@index([organizationId])
  @@index([userProfileId])
  @@index([role])
  @@map("organization_memberships")
}

/// Clinic membership linking a user profile with a specific clinic branch role
model ClinicMembership {
  id            String   @id @default(uuid())
  clinicId      String   @map("clinic_id")
  userProfileId String   @map("user_profile_id")
  role          String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userProfileId])
  @@index([clinicId])
  @@index([userProfileId])
  @@index([role])
  @@map("clinic_memberships")
}

/// Immutable audit log for tracking administrative and clinical operations
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  clinicId       String?  @map("clinic_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  actorUser    UserProfile?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clinicId])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Doctor medical practitioner entity
model Doctor {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  clinicId           String   @map("clinic_id")
  userProfileId      String?  @map("user_profile_id")
  fullName           String   @map("full_name")
  email              String?
  phone              String
  specialty          String
  qualification      String
  registrationNumber String   @map("registration_number")
  consultationFee    Float    @default(0) @map("consultation_fee")
  biography          String?
  profileImageUrl    String?  @map("profile_image_url")
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic             Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userProfile        UserProfile?              @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  clinicAssignments  DoctorClinicAssignment[]
  workingHours       DoctorWorkingHours[]
  scheduleExceptions DoctorScheduleException[]
  appointments       Appointment[]
  queueSettings      ClinicQueueSettings[]
  queueSessions      ClinicQueueSession[]

  @@unique([clinicId, registrationNumber])
  @@index([organizationId])
  @@index([clinicId])
  @@index([specialty])
  @@index([status])
  @@map("doctors")
}

/// Cross-clinic assignment for doctors operating across multiple branches in an organization
model DoctorClinicAssignment {
  id             String   @id @default(uuid())
  doctorId       String   @map("doctor_id")
  clinicId       String   @map("clinic_id")
  organizationId String   @map("organization_id")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")

  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId])
  @@index([organizationId])
  @@index([clinicId])
  @@map("doctor_clinic_assignments")
}

/// Operational staff members (Receptionists, Laboratory technicians, Nurses, Administrative)
model StaffMember {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  clinicId         String   @map("clinic_id")
  userProfileId    String?  @map("user_profile_id")
  fullName         String   @map("full_name")
  email            String
  phone            String
  designation      String
  department       String
  employmentStatus String   @default("ACTIVE") @map("employment_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userProfile  UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clinicId])
  @@index([designation])
  @@index([employmentStatus])
  @@map("staff_members")
}

/// Outpatient registry entity representing clinic patients
model Patient {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  clinicId              String   @map("clinic_id")
  userProfileId         String?  @map("user_profile_id")
  patientNumber         String   @map("patient_number")
  fullName              String   @map("full_name")
  dateOfBirth           String?  @map("date_of_birth")
  gender                String?
  phone                 String
  email                 String?
  address               String?
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  consentStatus         String   @default("GRANTED") @map("consent_status")
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userProfile  UserProfile?  @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  queueTokens  QueueToken[]
  whatsappContacts WhatsappContact[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId])
  @@index([clinicId])
  @@index([phone])
  @@index([status])
  @@map("patients")
}

/// Doctor weekly working hours configuration
model DoctorWorkingHours {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  clinicId            String    @map("clinic_id")
  doctorId            String    @map("doctor_id")
  dayOfWeek           Int       @map("day_of_week") // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime           String    @map("start_time") // HH:mm format, e.g. "09:00"
  endTime             String    @map("end_time") // HH:mm format, e.g. "17:00"
  slotDurationMinutes Int       @default(20) @map("slot_duration_minutes")
  breakStartTime      String?   @map("break_start_time") // HH:mm format, e.g. "13:00"
  breakEndTime        String?   @map("break_end_time") // HH:mm format, e.g. "14:00"
  effectiveFrom       DateTime  @default(now()) @map("effective_from")
  effectiveUntil      DateTime? @map("effective_until")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId, doctorId, dayOfWeek])
  @@index([doctorId, isActive])
  @@map("doctor_working_hours")
}

/// Doctor schedule exceptions (leaves, holidays, unavailable dates, custom working hours)
model DoctorScheduleException {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String   @map("clinic_id")
  doctorId       String   @map("doctor_id")
  exceptionDate  String   @map("exception_date") // YYYY-MM-DD
  exceptionType  String   @map("exception_type") // UNAVAILABLE, CUSTOM_HOURS
  startTime      String?  @map("start_time") // HH:mm for CUSTOM_HOURS
  endTime        String?  @map("end_time") // HH:mm for CUSTOM_HOURS
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId, exceptionDate])
  @@index([organizationId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([exceptionDate])
  @@map("doctor_schedule_exceptions")
}

/// Patient consultation appointments
model Appointment {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  clinicId           String   @map("clinic_id")
  doctorId           String   @map("doctor_id")
  patientId          String   @map("patient_id")
  appointmentNumber  String   @map("appointment_number") // APT-YYYY-XXXX
  appointmentDate    String   @map("appointment_date") // YYYY-MM-DD
  startTime          String   @map("start_time") // HH:mm
  endTime            String   @map("end_time") // HH:mm
  timezone           String   @default("Asia/Karachi")
  status             String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  bookingSource      String   @default("RECEPTIONIST") @map("booking_source") // ADMIN, RECEPTIONIST, PATIENT_PORTAL
  reasonForVisit     String?  @map("reason_for_visit")
  internalNotes      String?  @map("internal_notes")
  cancellationReason String?  @map("cancellation_reason")
  createdBy          String   @map("created_by") // Actor user ID
  cancelledBy        String?  @map("cancelled_by") // Actor user ID
  rescheduledFromId  String?  @map("rescheduled_from_id") // UUID reference to prior appointment
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic        Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor        Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  statusHistory AppointmentStatusHistory[]
  queueTokens   QueueToken[]

  @@unique([organizationId, appointmentNumber])
  @@index([organizationId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentDate])
  @@index([status])
  @@index([doctorId, clinicId, appointmentDate, startTime])
  @@map("appointments")
}

/// Historical audit log of every appointment status transition
model AppointmentStatusHistory {
  id             String   @id @default(uuid())
  appointmentId  String   @map("appointment_id")
  organizationId String   @map("organization_id")
  clinicId       String   @map("clinic_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  changedBy      String   @map("changed_by") // Actor user ID
  changeReason   String?  @map("change_reason")
  createdAt      DateTime @default(now()) @map("created_at")

  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([organizationId])
  @@index([clinicId])
  @@index([createdAt])
  @@map("appointment_status_history")
}

/// Clinic queue settings configuration for doctor or general OPD queues
model ClinicQueueSettings {
  id                           String   @id @default(uuid())
  organizationId               String   @map("organization_id")
  clinicId                     String   @map("clinic_id")
  doctorId                     String?  @map("doctor_id")
  queueName                    String   @map("queue_name")
  tokenPrefix                  String   @default("A") @map("token_prefix")
  tokenResetPolicy             String   @default("DAILY") @map("token_reset_policy")
  allowWalkIns                 Boolean  @default(true) @map("allow_walk_ins")
  allowAppointmentCheckIn      Boolean  @default(true) @map("allow_appointment_check_in")
  estimatedConsultationMinutes Int      @default(15) @map("estimated_consultation_minutes")
  maxQueueCapacity             Int?     @map("max_queue_capacity")
  publicQueueId                String   @unique @default(uuid()) @map("public_queue_id")
  isPublicDisplayEnabled       Boolean  @default(true) @map("is_public_display_enabled")
  isActive                     Boolean  @default(true) @map("is_active")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor?              @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  sessions     ClinicQueueSession[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([publicQueueId])
  @@map("clinic_queue_settings")
}

/// Daily operational queue sessions for a clinic/doctor
model ClinicQueueSession {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  clinicId           String    @map("clinic_id")
  doctorId           String?   @map("doctor_id")
  queueSettingsId    String    @map("queue_settings_id")
  sessionDate        String    @map("session_date") // YYYY-MM-DD in clinic timezone
  status             String    @default("NOT_STARTED") // NOT_STARTED, ACTIVE, PAUSED, CLOSED
  lastTokenNumber    Int       @default(0) @map("last_token_number")
  currentTokenNumber Int?      @map("current_token_number")
  totalRegistered    Int       @default(0) @map("total_registered")
  totalCompleted     Int       @default(0) @map("total_completed")
  startedAt          DateTime? @map("started_at")
  closedAt           DateTime? @map("closed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor        Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  queueSettings ClinicQueueSettings @relation(fields: [queueSettingsId], references: [id], onDelete: Cascade)
  tokens        QueueToken[]

  @@unique([queueSettingsId, sessionDate])
  @@index([organizationId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([sessionDate])
  @@index([status])
  @@map("clinic_queue_sessions")
}

/// Outpatient digital queue tokens
model QueueToken {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  clinicId             String    @map("clinic_id")
  queueSessionId       String    @map("queue_session_id")
  appointmentId        String?   @map("appointment_id")
  patientId            String    @map("patient_id")
  tokenNumber          Int       @map("token_number")
  tokenDisplay         String    @map("token_display") // e.g. A001
  queuePosition        Int       @default(0) @map("queue_position")
  status               String    @default("WAITING") // WAITING, CALLED, SERVING, COMPLETED, SKIPPED, CANCELLED, NO_SHOW
  priorityType         String    @default("NORMAL") @map("priority_type") // NORMAL, PRIORITY
  checkedInAt          DateTime  @default(now()) @map("checked_in_at")
  calledAt             DateTime? @map("called_at")
  serviceStartedAt     DateTime? @map("service_started_at")
  completedAt          DateTime? @map("completed_at")
  skippedAt            DateTime? @map("skipped_at")
  cancelledAt          DateTime? @map("cancelled_at")
  estimatedWaitMinutes Int?      @map("estimated_wait_minutes")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic        Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  queueSession  ClinicQueueSession   @relation(fields: [queueSessionId], references: [id], onDelete: Cascade)
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  statusHistory QueueStatusHistory[]

  @@unique([queueSessionId, tokenNumber])
  @@index([organizationId])
  @@index([clinicId])
  @@index([queueSessionId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@index([priorityType])
  @@map("queue_tokens")
}

/// Detailed audit trail of token status transitions
model QueueStatusHistory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String   @map("clinic_id")
  queueTokenId   String   @map("queue_token_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  changedBy      String   @map("changed_by")
  changeReason   String?  @map("change_reason")
  createdAt      DateTime @default(now()) @map("created_at")

  queueToken   QueueToken   @relation(fields: [queueTokenId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([queueTokenId])
  @@index([organizationId])
  @@index([clinicId])
  @@index([createdAt])
  @@map("queue_status_history")
}

/// Meta WhatsApp Business Account & Cloud API Integration per clinic
model WhatsappIntegration {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  clinicId             String    @unique @map("clinic_id")
  phoneNumberId        String    @unique @map("phone_number_id")
  wabaId               String    @map("waba_id")
  businessPhoneNumber  String    @map("business_phone_number")
  displayName          String?   @map("display_name")
  accessTokenEncrypted String    @map("access_token_encrypted")
  webhookVerifyToken   String    @map("webhook_verify_token")
  status               String    @default("PENDING") // PENDING, CONNECTED, DISCONNECTED, ERROR
  isWebhookVerified    Boolean   @default(false) @map("is_webhook_verified")
  lastConnectedAt      DateTime? @map("last_connected_at")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  templates    WhatsappMessageTemplate[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([phoneNumberId])
  @@index([status])
  @@map("whatsapp_integrations")
}

/// WhatsApp subscriber contacts mapped to patient records and consent tracking
model WhatsappContact {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  clinicId         String    @map("clinic_id")
  patientId        String?   @map("patient_id")
  waId             String    @map("wa_id") // E.164 digits without leading +
  profileName      String?   @map("profile_name")
  consentStatus    String    @default("UNKNOWN") @map("consent_status") // UNKNOWN, OPTED_IN, OPTED_OUT
  consentUpdatedAt DateTime? @map("consent_updated_at")
  optOutReason     String?   @map("opt_out_reason")
  lastInboundAt    DateTime? @map("last_inbound_at")
  lastOutboundAt   DateTime? @map("last_outbound_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic        Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient?               @relation(fields: [patientId], references: [id], onDelete: SetNull)
  conversations WhatsappConversation[]
  messages      WhatsappMessage[]

  @@unique([clinicId, waId])
  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId])
  @@index([waId])
  @@index([consentStatus])
  @@map("whatsapp_contacts")
}

/// Two-way WhatsApp chat session with 24-hr window and human receptionist handover
model WhatsappConversation {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  clinicId              String    @map("clinic_id")
  contactId             String    @map("contact_id")
  assignedUserId        String?   @map("assigned_user_id")
  status                String    @default("OPEN") // OPEN, HUMAN_HANDOVER, RESOLVED, CLOSED
  handoverReason        String?   @map("handover_reason")
  handoverAt            DateTime? @map("handover_at")
  resolvedAt            DateTime? @map("resolved_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  lastMessagePreview    String?   @map("last_message_preview")
  unreadCount           Int       @default(0) @map("unread_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  contact      WhatsappContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser UserProfile?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     WhatsappMessage[]
  aiState      AiConversationState?
  aiInteractionLogs AiInteractionLog[]
  aiToolExecutionLogs AiToolExecutionLog[]

  @@index([organizationId])
  @@index([clinicId])
  @@index([contactId])
  @@index([assignedUserId])
  @@index([status])
  @@index([lastCustomerMessageAt])
  @@map("whatsapp_conversations")
}

/// Individual WhatsApp inbound and outbound message with delivery status tracking
model WhatsappMessage {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  clinicId          String    @map("clinic_id")
  conversationId    String    @map("conversation_id")
  contactId         String    @map("contact_id")
  providerMessageId String?   @unique @map("provider_message_id") // Meta wamid
  direction         String    // INBOUND, OUTBOUND
  messageType       String    @default("text") @map("message_type") // text, template, interactive, image, document
  body              String?
  rawPayload        Json?     @map("raw_payload")
  templateName      String?   @map("template_name")
  templateParams    Json?     @map("template_params")
  status            String    @default("RECEIVED") // RECEIVED, QUEUED, SENT, DELIVERED, READ, FAILED
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      WhatsappContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([conversationId])
  @@index([contactId])
  @@index([providerMessageId])
  @@index([direction])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

/// Webhook event deduplication and processing audit ledger
model WhatsappWebhookEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique @map("event_id")
  eventType        String    @map("event_type")
  payload          Json
  processingStatus String    @default("RECEIVED") @map("processing_status") // RECEIVED, PROCESSING, PROCESSED, FAILED
  processedAt      DateTime? @map("processed_at")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([eventId])
  @@index([eventType])
  @@index([processingStatus])
  @@index([createdAt])
  @@map("whatsapp_webhook_events")
}

/// Approved Meta WhatsApp message templates per clinic/integration
model WhatsappMessageTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String   @map("clinic_id")
  integrationId  String?  @map("integration_id")
  name           String
  language       String   @default("en_US")
  category       String   @default("UTILITY") // UTILITY, MARKETING, AUTHENTICATION
  status         String   @default("APPROVED") // PENDING, APPROVED, REJECTED, PAUSED
  headerFormat   String?  @map("header_format")
  bodyTemplate   String   @map("body_template")
  footerTemplate String?  @map("footer_template")
  parameterNames String[] @default([]) @map("parameter_names")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  integration  WhatsappIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([clinicId, name, language])
  @@index([organizationId])
  @@index([clinicId])
  @@index([name])
  @@index([status])
  @@map("whatsapp_message_templates")
}

/// Configuration for the AI Multilingual Receptionist per organization/clinic
model AiAssistantSettings {
  id                        String   @id @default(uuid())
  organizationId            String   @map("organization_id")
  clinicId                  String?  @unique @map("clinic_id")
  assistantName             String   @default("ShifaDesk Assistant") @map("assistant_name")
  enabled                   Boolean  @default(true)
  defaultLanguage           String   @default("EN") @map("default_language") // EN, UR, PS
  supportedLanguages        String[] @default(["EN", "UR", "PS"]) @map("supported_languages")
  greetingMessage           String   @default("Hello! I am your clinic virtual receptionist. How can I assist you today?") @map("greeting_message")
  fallbackMessage           String   @default("I could not fully understand your request. Let me connect you with our human receptionist.") @map("fallback_message")
  humanHandoverEnabled      Boolean  @default(true) @map("human_handover_enabled")
  appointmentBookingEnabled Boolean  @default(true) @map("appointment_booking_enabled")
  tokenLookupEnabled        Boolean  @default(true) @map("token_lookup_enabled")
  clinicFaqEnabled          Boolean  @default(true) @map("clinic_faq_enabled")
  maxTurnsPerConversation   Int      @default(20) @map("max_turns_per_conversation")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@map("ai_assistant_settings")
}

/// Conversational context, booking workflow state, and active multi-turn steps
model AiConversationState {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  clinicId               String?   @map("clinic_id")
  conversationId         String    @unique @map("conversation_id")
  detectedLanguage       String    @default("en") @map("detected_language")
  currentIntent          String?   @map("current_intent")
  currentStep            String?   @map("current_step")
  conversationContext    Json      @default("{}") @map("conversation_context")
  handoverRequired       Boolean   @default(false) @map("handover_required")
  lastProcessedMessageId String?   @map("last_processed_message_id")
  lastActivityAt         DateTime  @default(now()) @map("last_activity_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([conversationId])
  @@index([lastActivityAt])
  @@map("ai_conversation_states")
}

/// Detailed audit ledger of conversational turns, token usage, latency, and costs
model AiInteractionLog {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  clinicId         String?  @map("clinic_id")
  conversationId   String   @map("conversation_id")
  inboundMessageId String?  @map("inbound_message_id")
  detectedLanguage String   @map("detected_language")
  detectedIntent   String   @map("detected_intent")
  provider         String
  model            String
  toolCalls        Json?    @map("tool_calls")
  outcome          String   // RESPONDED, HANDOVER, TOOL_EXECUTED, ERROR
  latencyMs        Int      @map("latency_ms")
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  estimatedCost    Float?   @map("estimated_cost")
  errorCode        String?  @map("error_code")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([detectedIntent])
  @@map("ai_interaction_logs")
}

/// Multilingual verified administrative clinic FAQs
model ClinicFaq {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  questionEn     String   @map("question_en")
  answerEn       String   @map("answer_en")
  questionUr     String?  @map("question_ur")
  answerUr       String?  @map("answer_ur")
  questionPs     String?  @map("question_ps")
  answerPs       String?  @map("answer_ps")
  category       String   @default("GENERAL") // GENERAL, APPOINTMENTS, TIMINGS, FEES, LOCATION, SERVICES
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([category])
  @@index([isActive])
  @@map("clinic_faqs")
}

/// Controlled execution log of AI tool invocations with non-sensitive audit references
model AiToolExecutionLog {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  clinicId            String?  @map("clinic_id")
  conversationId      String   @map("conversation_id")
  toolName            String   @map("tool_name")
  executionStatus     String   @map("execution_status") // SUCCESS, FAILED, REJECTED
  requestReference    String?  @map("request_reference")
  resultReference     String?  @map("result_reference")
  errorCode           String?  @map("error_code")
  executionDurationMs Int      @map("execution_duration_ms")
  createdAt           DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clinicId])
  @@index([conversationId])
  @@index([toolName])
  @@index([createdAt])
  @@map("ai_tool_execution_logs")
}
