/// Audit log for accessing analytics dashboards and sensitive reporting views
model AnalyticsAccessLog {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  clinicId        String?  @map("clinic_id")
  dashboardView   String   @map("dashboard_view") // EXECUTIVE, APPOINTMENTS, QUEUE, PATIENTS, STAFF, LABORATORY, FINANCE, COMMUNICATIONS, AI_USAGE
