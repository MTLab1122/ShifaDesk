/// Configurable notification rules for appointment, queue, and staff operational events
model NotificationRule {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  clinicId              String   @map("clinic_id")
  eventType             String   @map("event_type") // APPOINTMENT_BOOKED, APPOINTMENT_CONFIRMED, APPOINTMENT_REMINDER, etc.
  channel               String   // WHATSAPP, IN_APP, EMAIL, SMS
  templateId            String?  @map("template_id")
