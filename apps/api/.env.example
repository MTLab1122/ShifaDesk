# NestJS API Environment Template
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matabai_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/matabai_dev?schema=public"

# Supabase Credentials (Backend only)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Security
JWT_SECRET=dev-jwt-secret-key-at-least-32-characters-long-matabai
JWT_EXPIRATION=7d
