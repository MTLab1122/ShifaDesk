# ==============================================================================
# MatabAI (ShifaDesk) - Staging Environment Template
# ==============================================================================
# Use this configuration for staging validation and smoke testing.
# Connects to staging database instances and sandbox third-party accounts.
# ==============================================================================

NODE_ENV=staging

# Backend API
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=https://staging.matabai.com
LOG_LEVEL=info
LOG_FORMAT=json

# Staging Database (PgBouncer Pooler & Direct URL with SSL)
DATABASE_URL=postgresql://postgres.staging_ref:staging_db_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=20&pool_timeout=10
DIRECT_URL=postgresql://postgres.staging_ref:staging_db_password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Staging Supabase
SUPABASE_URL=https://staging-ref.supabase.co
SUPABASE_ANON_KEY=staging-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key-placeholder

# Staging JWT Secret (Minimum 32 characters)
JWT_SECRET=staging-jwt-secret-matabai-health-staging-key-at-least-32-chars
JWT_EXPIRATION=2d

# Meta WhatsApp Cloud API (Staging Sandbox Test App)
META_APP_ID=staging-meta-app-id
META_APP_SECRET=staging-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=staging-verify-token-at-least-8-chars
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# AI Multilingual Receptionist (Staging)
AI_PROVIDER=openai
AI_API_KEY=staging-openai-api-key
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT=15000
AI_TEMPERATURE=0.2

# Staging Email / SMS (Mailtrap / Test Gateway)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging-smtp-user
SMTP_PASSWORD=staging-smtp-password
SMTP_FROM="MatabAI Staging <staging-noreply@matabai.com>"
SMS_GATEWAY_URL=https://staging-api.sms-gateway.pk/v1/send
SMS_API_KEY=staging-sms-key

# Staging Telephony & AI Voice Receptionist
TWILIO_ACCOUNT_SID=staging-twilio-account-sid
TWILIO_AUTH_TOKEN=staging-twilio-auth-token
TWILIO_PHONE_NUMBER=+92510000001
VOICE_WEBHOOK_BASE_URL=https://api-staging.matabai.com/api/v1/voice/webhook
VOICE_RECORDING_ENABLED=false
VOICE_DEFAULT_LANGUAGE=ur

# Staging Diagnostic Report Storage & AES-256-GCM Encryption Key
STORAGE_REPORT_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
REPORT_STORAGE_PATH=/data/staging-uploads/reports

# Staging Safepay Payment Gateway (Sandbox mode enabled)
SAFEPAY_API_KEY=sec_staging_safepay_api_key
SAFEPAY_SECRET_KEY=v1_staging_safepay_secret_key
SAFEPAY_SANDBOX=true

# Rate Limiting & Telemetry
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200
METRICS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

# Frontend Staging Configuration
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="MatabAI (ShifaDesk) [STAGING]"
NEXT_PUBLIC_API_URL=https://api-staging.matabai.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key-placeholder
