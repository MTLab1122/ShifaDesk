# ==============================================================================
# MatabAI (ShifaDesk) - Production Environment Template
# ==============================================================================
# Production configuration with strict security, enforced TLS, connection pooling,
# and high-availability database endpoints.
# NEVER commit the actual .env file or real secrets to Git.
# ==============================================================================

NODE_ENV=production

# Backend API Process Management
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.matabai.com,https://matabai.com
LOG_LEVEL=warn
LOG_FORMAT=json

# Production PostgreSQL Database (Supabase Transaction Pooler - Port 6543)
# Enforces SSL, query timeouts, and bounded connection pool sizes
DATABASE_URL=postgresql://postgres.prod_project_ref:PROD_SECURE_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=50&pool_timeout=15
# Direct Connection for Migrations (Direct Port 5432)
DIRECT_URL=postgresql://postgres.prod_project_ref:PROD_SECURE_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Production Credentials
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_ANON_KEY=prod_supabase_anon_public_key
# SECURITY ALERT: Never expose SERVICE_ROLE_KEY to client apps or frontend bundles
SUPABASE_SERVICE_ROLE_KEY=prod_supabase_service_role_secret_key

# JWT Production Authentication
# Generate using `openssl rand -hex 32` (Must be at least 32 characters)
JWT_SECRET=PROD_HIGH_ENTROPY_JWT_SECRET_AT_LEAST_64_CHARACTERS_LONG_FOR_CLINIC_OPS
JWT_EXPIRATION=24h

# Meta WhatsApp Business Cloud API (Production Verified Business WABA)
META_APP_ID=prod_meta_waba_app_id
META_APP_SECRET=prod_meta_waba_app_secret
META_WEBHOOK_VERIFY_TOKEN=prod_webhook_high_entropy_verify_token
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# AI Multilingual Receptionist (Production Model & Rate Boundaries)
AI_PROVIDER=openai
AI_API_KEY=sk-prod-openai-dedicated-production-api-key
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT=15000
AI_TEMPERATURE=0.2

# Production Notification Adapters (Enterprise SMTP & Pakistan PTA Compliant SMS)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=prod_sendgrid_secure_api_key
SMTP_FROM="MatabAI Healthcare <noreply@matabai.com>"
SMS_GATEWAY_URL=https://api.telenor.com.pk/sms/v1/send
SMS_API_KEY=prod_pta_registered_sms_api_key

# Telephony & AI Voice Receptionist (Production Twilio / PTA Trunk)
TWILIO_ACCOUNT_SID=AC_prod_twilio_account_sid
TWILIO_AUTH_TOKEN=prod_twilio_auth_token_secret
TWILIO_PHONE_NUMBER=+92510000000
VOICE_WEBHOOK_BASE_URL=https://api.matabai.com/api/v1/voice/webhook
VOICE_RECORDING_ENABLED=false
VOICE_DEFAULT_LANGUAGE=ur

# Diagnostic Report Storage & AES-256-GCM Encryption at Rest
# Dedicated 256-bit encryption key (`openssl rand -hex 32`)
STORAGE_REPORT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
REPORT_STORAGE_PATH=/data/matabai-storage/reports

# Production Safepay Payment Gateway (Live mode: SAFEPAY_SANDBOX=false)
SAFEPAY_API_KEY=sec_live_safepay_merchant_key
SAFEPAY_SECRET_KEY=v1_live_safepay_secret_key
SAFEPAY_SANDBOX=false

# Production Security, Rate Limiting & Telemetry
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
METRICS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=15000

# Frontend Production Configuration (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="MatabAI (ShifaDesk)"
NEXT_PUBLIC_API_URL=https://api.matabai.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=prod_supabase_anon_public_key
