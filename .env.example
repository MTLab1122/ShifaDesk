# ==============================================================================
# MatabAI (ShifaDesk) - Master Environment Template (Phases 0–15)
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit actual secrets, API keys, or production credentials to Git.
# ==============================================================================

# Global Runtime Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
LOG_FORMAT=text

# PostgreSQL / Supabase Database Configuration
# Transaction Pooler (port 6543) or direct connection (port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matabai_dev?sslmode=disable
# Direct connection for migrations when using PgBouncer / Supabase Pooler
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/matabai_dev?sslmode=disable

# Supabase Credentials (Backend)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
# SECURITY: Never expose SERVICE_ROLE_KEY to client applications (web/mobile)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Security
JWT_SECRET=dev-jwt-secret-key-at-least-32-characters-long-matabai
JWT_EXPIRATION=7d

# Meta WhatsApp Business Cloud API (Phase 6)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token-at-least-8-chars
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# AI Multilingual Receptionist (Phase 7)
AI_PROVIDER=openai
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT=15000
AI_TEMPERATURE=0.2

# Notification Engine Adapters (Phase 8)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="MatabAI Healthcare <noreply@matabai.com>"
SMS_GATEWAY_URL=https://api.sms-gateway.pk/v1/send
SMS_API_KEY=your-sms-api-key

# Telephony & AI Voice Receptionist (Phase 9)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+92510000000
VOICE_WEBHOOK_BASE_URL=http://localhost:4000/api/v1/voice/webhook
VOICE_RECORDING_ENABLED=false
VOICE_DEFAULT_LANGUAGE=ur

# Diagnostic Report Storage & AES-256-GCM Encryption (Phase 10)
# 64-hex char (32-byte) key for authenticated PDF report encryption at rest
STORAGE_REPORT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
REPORT_STORAGE_PATH=uploads/reports

# Online Payment Gateway (Safepay Pakistan) (Phases 11 & 14)
SAFEPAY_API_KEY=your-safepay-api-key
SAFEPAY_SECRET_KEY=your-safepay-secret-key
SAFEPAY_SANDBOX=true

# Production Hardening, Rate Limiting & Telemetry (Phase 15)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
METRICS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="MatabAI (ShifaDesk)"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
