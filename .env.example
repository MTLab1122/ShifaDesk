# ==============================================================================
# MatabAI (ShifaDesk) - Master Environment Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit actual secrets, API keys, or production credentials to Git.
# ==============================================================================

# Global Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# PostgreSQL / Supabase Database Configuration
# Transaction Pooler (port 6543) or direct connection (port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matabai_dev?sslmode=disable
# Direct connection for migrations when using PgBouncer / Supabase Pooler
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/matabai_dev?sslmode=disable

# Supabase Credentials (Backend)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
# SECURITY: Never expose SERVICE_ROLE_KEY to client applications (web/mobile)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication & Security
JWT_SECRET=dev-jwt-secret-key-at-least-32-characters-long-matabai
JWT_EXPIRATION=7d

# Meta WhatsApp Business Cloud API (Phase 6)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token-at-least-8-chars
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# AI Multilingual Receptionist (Phase 7)
AI_PROVIDER=openai
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT=15000
AI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="MatabAI (ShifaDesk)"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
